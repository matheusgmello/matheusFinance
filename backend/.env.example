# Nenhuma variável abaixo é obrigatória para rodar local — o backend
# tem valores padrão de desenvolvimento pra todas.

JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

# Web Push (Configurações > Notificações). Sem estas, o push fica desativado.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Override de conexão com o banco — padrão aponta pro Postgres da porta 5435.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/matheusfinance
# SPRING_DATASOURCE_USERNAME=finance_user
# SPRING_DATASOURCE_PASSWORD=finance_pass
